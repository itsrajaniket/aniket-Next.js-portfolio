# ── Copy this file to .env.local and fill in your values ───────────────────

# Google Analytics Measurement ID
# Steps:
#   1. Go to https://analytics.google.com
#   2. Admin → Create Property → Web data stream
#   3. Copy the "G-XXXXXXXXXX" ID shown on the stream detail page
#   4. Paste it below — analytics only activates in production (npm run build)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend API key for contact form emails
# Get yours free at https://resend.com/api-keys (100 emails/day free)

RESEND_API_KEY=re_gQqXWCqy_2up4fCKusDNxt3QRDwP4Bh4v
# Your deployed site URL
NEXT_PUBLIC_SITE_URL=https://itsrajaniket.vercel.app
